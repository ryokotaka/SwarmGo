# wrk2 (giltene/wrk2) at a pinned commit. Its bundled LuaJIT 2.0.3 has no
# ARM64 support, so it is replaced by LuaJIT 2.1 at a pinned commit, and the
# one type LuaJIT 2.1 removed (luaL_reg, now luaL_Reg) is renamed in
# src/script.c. The measurement code is unchanged.
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libssl-dev ca-certificates
WORKDIR /src
COPY wrk2-src/ ./
COPY luajit-src/ /luajit/
RUN rm -rf deps/luajit && cp -r /luajit deps/luajit \
 && sed -i 's/\bluaL_reg\b/luaL_Reg/g' src/script.c \
 && make -j4
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN apt-get update && apt-get install -y --no-install-recommends libssl3 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/wrk /usr/local/bin/wrk2
