# wrk2 (giltene/wrk2) at a pinned commit, made to build on ARM64:
# - its bundled LuaJIT 2.0.3 has no ARM64 support, so it is replaced by
#   LuaJIT 2.1 at a pinned commit, and the one type LuaJIT 2.1 removed
#   (luaL_reg, now luaL_Reg) is renamed in src/script.c;
# - src/hdr_histogram.c includes the x86-only <x86intrin.h> without using any
#   intrinsic, so that line is removed. It also includes <zlib.h> (header only;
#   no zlib function is linked), hence zlib1g-dev;
# - src/wrk.c stores getopt_long's result in a char and compares it with -1.
#   char is unsigned on ARM64, so -1 is never seen and every command line ends
#   in the usage text; the variable becomes an int;
# - src/wrk.c times everything with gettimeofday, a wall clock that can step
#   backwards when the clock is adjusted (the Docker VM syncs its clock with
#   the host). A backward step makes a latency negative, which aborts wrk2
#   in its histogram, and distorts its send schedule. time_us() now reads
#   CLOCK_MONOTONIC; wrk2 only uses these times as differences.
# Each edit is checked, so the build fails if one does not apply. The
# rate-control and latency code is unchanged.
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libssl-dev zlib1g-dev ca-certificates
WORKDIR /src
COPY wrk2-src/ ./
COPY luajit-src/ /luajit/
RUN rm -rf deps/luajit && cp -r /luajit deps/luajit \
 && sed -i 's/\bluaL_reg\b/luaL_Reg/g' src/script.c \
 && sed -i '/#include <x86intrin.h>/d' src/hdr_histogram.c \
 && sed -i 's/^    char c, \*\*header = headers;$/    int c;\n    char **header = headers;/' src/wrk.c \
 && ! grep -qw 'luaL_reg' src/script.c \
 && ! grep -q 'x86intrin' src/hdr_histogram.c \
 && sed -i 's/^    struct timeval t;$/    struct timespec t;/; s/^    gettimeofday(&t, NULL);$/    clock_gettime(CLOCK_MONOTONIC, \&t);/; s/^    return (t.tv_sec \* 1000000) + t.tv_usec;$/    return (t.tv_sec * 1000000) + t.tv_nsec \/ 1000;/' src/wrk.c \
 && grep -qx '    int c;' src/wrk.c \
 && grep -qx '    clock_gettime(CLOCK_MONOTONIC, &t);' src/wrk.c \
 && ! grep -q 'gettimeofday' src/wrk.c \
 && make -j4
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN apt-get update && apt-get install -y --no-install-recommends libssl3 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/wrk /usr/local/bin/wrk2
